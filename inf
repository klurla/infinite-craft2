(function() {
    // Eski menü veya top varsa temizle
    const oldUI = document.getElementById('tekdoz-ic-bot-v20') || document.getElementById('tekdoz-ic-bot-v18');
    const oldBall = document.getElementById('tekdoz-mini-ball');
    if (oldUI) oldUI.remove();
    if (oldBall) oldBall.remove();

    // --- RATE LIMIT (429) BYPASS MOTORU ---
    let isRateLimited = false;
    let rateLimitEndTime = 0;
    const COOLDOWN_MS = 6000; // Rate limit yendiğinde beklenecek soğuma süresi (ms)

    if (!window.__tekdozFetchPatched) {
        const originalFetch = window.fetch;
        window.fetch = async function(...args) {
            const response = await originalFetch.apply(this, args);
            if (response && response.status === 429) {
                console.warn("[Tekdoz Bot] Rate Limit (429) yakalandı! Bot soğumaya alınıyor...");
                isRateLimited = true;
                rateLimitEndTime = Date.now() + COOLDOWN_MS;
            }
            return response;
        };
        window.__tekdozFetchPatched = true;
    }

    async function rateLimitKontrol() {
        while (isRateLimited) {
            const kalanSec = Math.ceil((rateLimitEndTime - Date.now()) / 1000);
            if (kalanSec > 0) {
                if (typeof infoText !== 'undefined' && infoText) {
                    infoText.innerText = `⏳ Rate Limit (429)! ${kalanSec}sn bekleniyor...`;
                }
                await new Promise(r => setTimeout(r, 500));
            } else {
                isRateLimited = false;
                if (typeof infoText !== 'undefined' && infoText) {
                    infoText.innerText = `⚡ Rate Limit bitti, devam ediliyor...`;
                }
            }
        }
    }

    // --- DEĞİŞKENLER VE DURUM ---
    let aktifSekme = 'solver';    // 'bot' | 'birleştir' | 'solver'
    let aktifMod = 'ustten_alta'; // 'ustten_alta' | 'alttan_uste' | 'rastgele'
    let konumModu = 'rastgele';   // 'rastgele' | 'ortada'
    let hizMS = 350;              // Oto Koyma Hızı (Min: 1ms)
    let combineHizMS = 400;       // Oto Birleştir Hızı (Min: 1ms)
    let solverHizMS = 300;        // Tarif Hızı (Min: 1ms)
    let maxRastgeleTekrar = 3;    // Rastgele Modu Çarpan Limiti (1 - 5)
    
    let calisiyor = false;
    let combineCalisiyor = false;
    let solverCalisiyor = false;
    let mevcutIndex = 0;

    // TARİF KÜTÜPHANESİ
    let recipeBook = {}; 

    function normalizeText(str) {
        if (!str) return '';
        return str.toLowerCase().replace(/[^a-z0-9]/g, '');
    }

    function parseAndBuildRecipeBook(text) {
        recipeBook = {};
        const lines = text.split(/[\r\n;]+/);
        const steps = [];

        for (let line of lines) {
            line = line.trim();
            if (!line || !line.includes('+')) continue;

            let [inputs, result] = line.split(/=|->|=>/);
            if (inputs) {
                let parts = inputs.split('+');
                if (parts.length >= 2) {
                    const first = parts[0].trim();
                    const second = parts[1].trim();
                    const resName = result ? result.trim() : 'Sonuç';
                    if (first && second) {
                        const stepObj = { first, second, result: resName };
                        steps.push(stepObj);
                        recipeBook[normalizeText(resName)] = stepObj;
                    }
                }
            }
        }
        return steps;
    }

    // ==========================================
    // YARDIMCI: KLAVYEYLE DÜZENLENEBİLİR HIZ BİLEŞENİ (1ms MIN)
    // ==========================================
    function createSpeedControl(titleText, initialVal, colorHex, onChangeCallback) {
        const container = document.createElement('div');
        container.style.cssText = 'display: flex; flex-direction: column; gap: 4px; margin-bottom: 8px; background: #18181b; padding: 8px; border-radius: 8px; border: 1px solid #3f3f46;';

        const topRow = document.createElement('div');
        topRow.style.cssText = 'display: flex; justify-content: space-between; align-items: center;';

        const label = document.createElement('span');
        label.innerText = titleText;
        label.style.cssText = `font-size: 11px; color: ${colorHex}; font-weight: bold;`;

        const inputGroup = document.createElement('div');
        inputGroup.style.cssText = 'display: flex; align-items: center; gap: 2px;';

        const numInput = document.createElement('input');
        numInput.type = 'text';
        numInput.value = initialVal;
        numInput.style.cssText = `
            width: 50px; background: #27272a; color: #ffffff; border: 1px solid #3f3f46;
            border-radius: 4px; padding: 2px 4px; font-size: 11px; font-weight: bold;
            text-align: center; outline: none; transition: border-color 0.2s;
        `;
        numInput.onfocus = () => numInput.style.borderColor = colorHex;
        numInput.onblur = () => numInput.style.borderColor = '#3f3f46';

        const unit = document.createElement('span');
        unit.innerText = ' ms';
        unit.style.cssText = 'font-size: 11px; color: #a1a1aa; font-weight: bold;';

        inputGroup.appendChild(numInput);
        inputGroup.appendChild(unit);
        topRow.appendChild(label);
        topRow.appendChild(inputGroup);

        const rangeInput = document.createElement('input');
        rangeInput.type = 'range';
        rangeInput.min = '1';
        rangeInput.max = '2000';
        rangeInput.step = '1';
        rangeInput.value = initialVal;
        rangeInput.style.cursor = 'pointer';

        function syncValue(val) {
            let num = parseInt(val);
            if (isNaN(num) || num < 1) num = 1;
            numInput.value = num;
            rangeInput.value = Math.min(num, 2000); // Slider maks 2000 gösterir ama manuel daha yüksek yazılabilir
            onChangeCallback(num);
        }

        // Sadece rakam girilmesini sağla
        numInput.onkeydown = (e) => {
            if (!/[0-9]/.test(e.key) && !['Backspace', 'Delete', 'ArrowLeft', 'ArrowRight', 'Tab', 'Enter'].includes(e.key)) {
                e.preventDefault();
            }
        };

        numInput.oninput = (e) => {
            let cleanVal = e.target.value.replace(/[^0-9]/g, '');
            if (cleanVal === '') cleanVal = '1';
            syncValue(cleanVal);
        };

        rangeInput.oninput = (e) => {
            syncValue(e.target.value);
        };

        container.appendChild(topRow);
        container.appendChild(rangeInput);
        return container;
    }


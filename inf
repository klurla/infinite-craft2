    function getSidebarItems() {
        let items = Array.from(document.querySelectorAll('.sidebar .item, .items-container .item, .items .item'));
        if (items.length === 0) {
            items = Array.from(document.querySelectorAll('.item')).filter(el => el.getBoundingClientRect().left > (window.innerWidth * 0.5));
        }
        return items;
    }

    function getBoardItems() {
        return Array.from(document.querySelectorAll('.instance, .container .instance')).filter(el => {
            const rect = el.getBoundingClientRect();
            return rect.left < (window.innerWidth * 0.70) && rect.width > 0 && rect.height > 0;
        });
    }

    function esyayiMasayaAt(itemElement, posX, posY) {
        if (!itemElement) return;

        let targetX, targetY;

        if (posX !== undefined && posY !== undefined) {
            targetX = posX;
            targetY = posY;
        } else if (konumModu === 'ortada') {
            targetX = window.innerWidth * 0.35;
            targetY = window.innerHeight * 0.40;
        } else {
            const minX = 80;
            const maxX = Math.max(minX + 50, window.innerWidth * 0.60);
            const minY = 80;
            const maxY = Math.max(minY + 50, window.innerHeight * 0.80);

            targetX = Math.floor(Math.random() * (maxX - minX)) + minX;
            targetY = Math.floor(Math.random() * (maxY - minY)) + minY;
        }

        const eventOpts = { bubbles: true, cancelable: true, view: window, clientX: targetX, clientY: targetY, pageX: targetX, pageY: targetY };
        itemElement.dispatchEvent(new MouseEvent('mousedown', eventOpts));
        itemElement.dispatchEvent(new MouseEvent('mouseup', eventOpts));
        itemElement.dispatchEvent(new MouseEvent('click', eventOpts));
    }

    function ikiEsyayiBirlestir(el1, el2) {
        if (!el1 || !el2) return;
        const rect1 = el1.getBoundingClientRect();
        const rect2 = el2.getBoundingClientRect();
        const x1 = rect1.left + rect1.width / 2, y1 = rect1.top + rect1.height / 2;
        const x2 = rect2.left + rect2.width / 2, y2 = rect2.top + rect2.height / 2;

        const down = new MouseEvent('mousedown', { bubbles: true, cancelable: true, clientX: x1, clientY: y1, buttons: 1 });
        const move = new MouseEvent('mousemove', { bubbles: true, cancelable: true, clientX: x2, clientY: y2, buttons: 1 });
        const up = new MouseEvent('mouseup', { bubbles: true, cancelable: true, clientX: x2, clientY: y2 });

        el1.dispatchEvent(down);
        document.dispatchEvent(move);
        el2.dispatchEvent(up);
    }

    async function masayaEsyaCikarByName(esyaAdi, posX, posY) {
        await rateLimitKontrol();
        let sidebarItems = getSidebarItems();
        const hedefNorm = normalizeText(esyaAdi);

        let hedefEl = sidebarItems.find(el => normalizeText(el.innerText || el.textContent) === hedefNorm);

        if (!hedefEl) {
            const searchInput = document.querySelector('.sidebar-input, .sidebar input, input[placeholder*="Search"]');
            if (searchInput) {
                const nativeSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;
                nativeSetter.call(searchInput, esyaAdi);
                searchInput.dispatchEvent(new Event('input', { bubbles: true }));
                await new Promise(r => setTimeout(r, 40));

                sidebarItems = getSidebarItems();
                hedefEl = sidebarItems.find(el => normalizeText(el.innerText || el.textContent) === hedefNorm);

                nativeSetter.call(searchInput, '');
                searchInput.dispatchEvent(new Event('input', { bubbles: true }));
            }
        }

        if (!hedefEl) {
            const sidebarScroll = document.querySelector('.sidebar, .items-container, .items');
            if (sidebarScroll) {
                const step = 400;
                for (let s = 0; s <= sidebarScroll.scrollHeight; s += step) {
                    sidebarScroll.scrollTop = s;
                    await new Promise(r => setTimeout(r, 10));
                    sidebarItems = getSidebarItems();
                    hedefEl = sidebarItems.find(el => normalizeText(el.innerText || el.textContent) === hedefNorm);
                    if (hedefEl) break;
                }
            }
        }

        if (hedefEl) {
            esyayiMasayaAt(hedefEl, posX, posY);
            return true;
        }
        return false;
    }

    async function itemVarMiMenude(esyaAdi) {
        let sidebarItems = getSidebarItems();
        const norm = normalizeText(esyaAdi);
        let varMi = sidebarItems.some(el => normalizeText(el.innerText || el.textContent) === norm);
        if (varMi) return true;

        const searchInput = document.querySelector('.sidebar-input, .sidebar input, input[placeholder*="Search"]');
        if (searchInput) {
            const nativeSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;
            nativeSetter.call(searchInput, esyaAdi);
            searchInput.dispatchEvent(new Event('input', { bubbles: true }));
            await new Promise(r => setTimeout(r, 30));

            sidebarItems = getSidebarItems();
            varMi = sidebarItems.some(el => normalizeText(el.innerText || el.textContent) === norm);

            nativeSetter.call(searchInput, '');
            searchInput.dispatchEvent(new Event('input', { bubbles: true }));
        }

        return varMi;
    }

    async function masadanYeniEsyaBekle(eskiSayi, timeout = 300) {
        const start = Date.now();
        while (Date.now() - start < timeout) {
            await rateLimitKontrol();
            const currentBoard = getBoardItems();
            if (currentBoard.length > eskiSayi) {
                return currentBoard[currentBoard.length - 1];
            }
            await new Promise(r => setTimeout(r, 10));
        }
        return null;
    }

    // ==========================================
    // 5. REKÜRSİF EŞYA ÜRETİCİ VE GARANTİ EDİCİ
    // ==========================================

    async function esyayiGarantiEt(esyaAdi, visiting = new Set()) {
        if (!solverCalisiyor) return false;
        await rateLimitKontrol();

        const norm = normalizeText(esyaAdi);

        if (await itemVarMiMenude(esyaAdi)) {
            return true;
        }

        if (visiting.has(norm)) {
            infoText.innerText = `⚠️ Tarif Döngüsü: ${esyaAdi}`;
            return false;
        }

        const recipe = recipeBook[norm];
        if (!recipe) {
            infoText.innerText = `❌ "${esyaAdi}" menüde yok ve tarifi bulunamadı!`;
            return false;
        }

        visiting.add(norm);

        infoText.innerText = `🛠️ Eksik Üretiliyor: ${esyaAdi} (${recipe.first} + ${recipe.second})`;

        const ok1 = await esyayiGarantiEt(recipe.first, new Set(visiting));
        if (!ok1) return false;

        const ok2 = await esyayiGarantiEt(recipe.second, new Set(visiting));
        if (!ok2) return false;

        const targetX = window.innerWidth * 0.35;
        const targetY = window.innerHeight * 0.40;

        const count1 = getBoardItems().length;
        await masayaEsyaCikarByName(recipe.first, targetX, targetY);
        let el1 = await masadanYeniEsyaBekle(count1, Math.max(50, solverHizMS * 2));

        const count2 = getBoardItems().length;
        await masayaEsyaCikarByName(recipe.second, targetX + 15, targetY + 15);
        let el2 = await masadanYeniEsyaBekle(count2, Math.max(50, solverHizMS * 2));

        if (el1 && el2) {
            await rateLimitKontrol();
            ikiEsyayiBirlestir(el1, el2);
            infoText.innerText = `✨ Üretildi: ${recipe.result}`;
            await new Promise(r => setTimeout(r, Math.max(10, solverHizMS)));
        }

        visiting.delete(norm);

        return await itemVarMiMenude(esyaAdi);
    }

    // ==========================================
    // 6. OTO KOYMA MANTIĞI
    // ==========================================

    async function otoKoymaDongusu() {
        while (calisiyor) {
            await rateLimitKontrol();
            const items = getSidebarItems();
            if (items.length === 0) {
                infoText.innerText = 'Menüde eşya bulunamadı!';
                await new Promise(r => setTimeout(r, 500));
                continue;
            }

            if (aktifMod === 'ustten_alta') {
                if (mevcutIndex >= items.length) mevcutIndex = 0;
                const targetEl = items[mevcutIndex];
                mevcutIndex++;
                if (targetEl) {
                    esyayiMasayaAt(targetEl);
                    infoText.innerText = `Koyuldu: ${(targetEl.innerText || targetEl.textContent).trim()}`;
                }
                await new Promise(r => setTimeout(r, hizMS));
            } else if (aktifMod === 'alttan_uste') {
                if (mevcutIndex < 0 || mevcutIndex >= items.length) mevcutIndex = items.length - 1;
                const targetEl = items[mevcutIndex];
                mevcutIndex--;
                if (targetEl) {
                    esyayiMasayaAt(targetEl);
                    infoText.innerText = `Koyuldu: ${(targetEl.innerText || targetEl.textContent).trim()}`;
                }
                await new Promise(r => setTimeout(r, hizMS));
            } else if (aktifMod === 'rastgele') {
                const rnd = Math.floor(Math.random() * items.length);
                const targetEl = items[rnd];
                
                const tekrarSayisi = Math.floor(Math.random() * maxRastgeleTekrar) + 1;
                const esyaAdi = (targetEl.innerText || targetEl.textContent).trim();

                for (let t = 0; t < tekrarSayisi; t++) {
                    if (!calisiyor) break;
                    await rateLimitKontrol();
                    esyayiMasayaAt(targetEl);
                    infoText.innerText = `🎲 Rastgele (${t + 1}/${tekrarSayisi}): ${esyaAdi}`;
                    await new Promise(r => setTimeout(r, hizMS));
                }
            }
        }
    }

    botStartBtn.onclick = () => {
        calisiyor = !calisiyor;
        if (calisiyor) {
            botStartBtn.innerText = '⏹ DURDUR';
            botStartBtn.style.backgroundColor = '#dc2626';
            infoText.innerText = 'Oto Koyma başlatıldı...';
            otoKoymaDongusu();
        } else {
            botStartBtn.innerText = '▶️ OTO KOYMAYI BAŞLAT';
            botStartBtn.style.backgroundColor = '#0284c7';
            infoText.innerText = 'Oto Koyma durduruldu.';
        }
    };

    // ==========================================
    // 7. TABLODAKİ EŞYALARI BİRLEŞTİRME
    // ==========================================

    async function masadakiTumKombinasyonlariDene() {
        combineCalisiyor = true;
        combineBtn.innerText = '⏹️ BİRLEŞTİRMEYİ DURDUR';
        combineBtn.style.backgroundColor = '#dc2626';

        while (combineCalisiyor) {
            await rateLimitKontrol();
            let boardItems = getBoardItems();

            if (boardItems.length < 2) {
                infoText.innerText = '⚠️ Tabloda/Masada en az 2 eşya olmalı!';
                await new Promise(r => setTimeout(r, 600));
                continue;
            }

            let yapildi = false;

            for (let i = 0; i < boardItems.length - 1; i++) {
                for (let j = i + 1; j < boardItems.length; j++) {
                    if (!combineCalisiyor) break;

                    await rateLimitKontrol();
                    const guncelBoard = getBoardItems();
                    const el1 = boardItems[i];
                    const el2 = boardItems[j];

                    if (guncelBoard.includes(el1) && guncelBoard.includes(el2)) {
                        const name1 = (el1.innerText || el1.textContent).trim();
                        const name2 = (el2.innerText || el2.textContent).trim();

                        infoText.innerText = `🧪 Masadakiler: ${name1} + ${name2}`;

                        ikiEsyayiBirlestir(el1, el2);
                        yapildi = true;

                        await new Promise(r => setTimeout(r, combineHizMS));
                    }
                }
                if (!combineCalisiyor) break;
            }

            if (!yapildi && combineCalisiyor) {
                infoText.innerText = '🔄 Masadaki tur bitti, yeni eşya bekleniyor...';
                await new Promise(r => setTimeout(r, 500));
            }
        }

        combineCalisiyor = false;
        combineBtn.innerText = '⚡ TABLODAKİ TÜM EŞYALARI BİRLEŞTİR';
        combineBtn.style.backgroundColor = '#7c3aed';
    }

    combineBtn.onclick = () => {
        if (combineCalisiyor) {
            combineCalisiyor = false;
            combineBtn.innerText = '⚡ TABLODAKİ TÜM EŞYALARI BİRLEŞTİR';
            combineBtn.style.backgroundColor = '#7c3aed';
            infoText.innerText = 'Birleştirme durduruldu.';
        } else {
            masadakiTumKombinasyonlariDene();
        }
    };

    // ==========================================
    // 8. YEREL TARİF ÇÖZÜCÜ
    // ==========================================

    async function tarifiBulAndCoz(inputStr) {
        if (!inputStr || inputStr.trim() === '') {
            infoText.innerText = 'Lütfen metin tarifini yapıştırın!';
            return;
        }

        solverCalisiyor = true;
        solveBtn.innerText = 'DURDUR';
        solveBtn.style.backgroundColor = '#dc2626';

        infoText.innerText = '📝 Tarif kitabı analiz ediliyor...';
        const adimlar = parseAndBuildRecipeBook(inputStr);

        if (!Array.isArray(adimlar) || adimlar.length === 0) {
            infoText.innerText = `❌ Geçerli bir tarif okunamadı!`;
            solverCalisiyor = false;
            solveBtn.innerText = '🚀 TARİFİ BAŞLAT';
            solveBtn.style.backgroundColor = '#0284c7';
            return;
        }

        infoText.innerText = `✅ ${adimlar.length} Adımlık Tarif Başlatılıyor...`;

        const targetX = window.innerWidth * 0.35;
        const targetY = window.innerHeight * 0.40;

        for (let i = 0; i < adimlar.length; i++) {
            if (!solverCalisiyor) break;
            await rateLimitKontrol();

            const step = adimlar[i];
            const first = step.first;
            const second = step.second;
            const result = step.result || 'Sonuç';

            if (result && result !== 'Sonuç' && await itemVarMiMenude(result)) {
                infoText.innerText = `[${i + 1}/${adimlar.length}] ⏭️ [ATLANDI] "${result}" zaten var.`;
                await new Promise(r => setTimeout(r, 20));
                continue;
            }

            infoText.innerText = `[${i + 1}/${adimlar.length}] Kontrol Ediliyor: ${first} + ${second}`;

            const ok1 = await esyayiGarantiEt(first);
            const ok2 = await esyayiGarantiEt(second);

            if (ok1 && ok2) {
                await rateLimitKontrol();
                infoText.innerText = `[${i + 1}/${adimlar.length}] ${first} + ${second} ➔ ${result}`;

                const count1 = getBoardItems().length;
                await masayaEsyaCikarByName(first, targetX, targetY);
                let el1 = await masadanYeniEsyaBekle(count1, Math.max(50, solverHizMS * 2));

                const count2 = getBoardItems().length;
                await masayaEsyaCikarByName(second, targetX + 15, targetY + 15);
                let el2 = await masadanYeniEsyaBekle(count2, Math.max(50, solverHizMS * 2));

                if (el1 && el2) {
                    ikiEsyayiBirlestir(el1, el2);
                } else {
                    const boardItems = getBoardItems();
                    if (boardItems.length >= 2) {
                        ikiEsyayiBirlestir(boardItems[boardItems.length - 2], boardItems[boardItems.length - 1]);
                    }
                }
            } else {
                const eksik = !ok1 ? first : second;
                infoText.innerText = `⚠️ "${eksik}" üretilemedi, sonraki adıma geçiliyor...`;
                await new Promise(r => setTimeout(r, 200));
            }

            await new Promise(r => setTimeout(r, solverHizMS));
        }

        if (solverCalisiyor) {
            infoText.innerText = `🎉 Tüm Tarif Adımları Başarıyla İşlendi!`;
        }

        solverCalisiyor = false;
        solveBtn.innerText = '🚀 TARİFİ BAŞLAT';
        solveBtn.style.backgroundColor = '#0284c7';
    }

    solveBtn.onclick = () => {
        if (solverCalisiyor) {
            solverCalisiyor = false;
            solveBtn.innerText = '🚀 TARİFİ BAŞLAT';
            solveBtn.style.backgroundColor = '#0284c7';
            infoText.innerText = 'İşlem durduruldu.';
            return;
        }

        tarifiBulAndCoz(targetInput.value);
    };

    console.log("%c[Tekdoz Bot] v20.0 (Custom Speed Inputs Enabled)", "color: #38bdf8; font-weight: bold;");
})();
